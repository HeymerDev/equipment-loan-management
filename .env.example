# Database
DATABASE_URL="postgresql://tuhosturlaqui:4000:pasosobre@localhost:5432/equipment_loan"

# JWT
JWT_SECRET="change-me-to-a-long-random-secret"
JWT_REFRESH_SECRET="change-me-to-another-long-random-secret"

# Server
PORT=3001

# Integration tests only (pnpm --filter @equipment-loan/api test:integration).
# Must point to a disposable, migratable database — never to a real one.
# TEST_DATABASE_URL="postgresql://test:test@localhost:54329/equipment_loan_test"

# Loan voucher PDF
INSTITUTION_NAME="Institución Educativa"
# IANA timezone for the voucher's generation time. Defaults to the server's timezone.
# APP_TIMEZONE="America/Bogota"

# Next.js public API base URL
NEXT_PUBLIC_API_URL="http://localhost:3001/api/v1"
